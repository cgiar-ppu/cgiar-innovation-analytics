# ===========================================================================
# Synapsis Analytics Agent – Environment Variables
# ===========================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# AUTH: The agent auto-detects your Claude Code subscription (~/.claude mount).
# The API key below is only needed as a FALLBACK if you're not using
# a Claude Code subscription.
# ===========================================================================

# OPTIONAL: Anthropic API key (only if NOT using Claude Code subscription)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use (default: claude-opus-4-6)
SYNAPSIS_MODEL=claude-opus-4-6

# Maximum agentic turns per query (default: 100)
SYNAPSIS_MAX_TURNS=100

# Fallback model (used if primary model fails)
SYNAPSIS_FALLBACK_MODEL=claude-sonnet-4-20250514

# Logging level: DEBUG, INFO, WARNING, ERROR
SYNAPSIS_LOG_LEVEL=INFO

# Max concurrent in-memory sessions (each spawns a CLI subprocess).
# Lower this on memory-constrained machines. (default: 10)
# SYNAPSIS_MAX_SESSIONS=10

# OPTIONAL: Shared folder for easy file exchange with the agent container.
# Set a host path and the agent can read/write files at /workspace/shared.
# Leave commented out to disable. The start scripts auto-detect a sensible
# default if this is set to "auto".
# Examples:
#   SYNAPSIS_SHARED_DIR=auto                          # ~/Documents/synapsis-shared (auto-detected)
#   SYNAPSIS_SHARED_DIR=C:/Users/you/Desktop/shared   # Windows explicit path
#   SYNAPSIS_SHARED_DIR=/Users/you/Desktop/shared     # macOS/Linux explicit path
# SYNAPSIS_SHARED_DIR=auto
