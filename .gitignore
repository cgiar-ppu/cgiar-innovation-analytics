data/search_index/prms_vectors.npy
data/search_index/prms_vectors_codes.json
data/search_index/prms_corpus.sqlite
# SQLite transient runtime files (WAL / shared-memory)
data/*.sqlite-shm
data/*.sqlite-wal
data/*.sqlite-journal
